# Netcup/Plesk zieht das Repo direkt nach httpdocs/. Ausgeliefert werden soll
# aber nur der Build, also schreibt diese Datei jede Anfrage nach dist/ um.
# Nebeneffekt und Absicht zugleich: Quellen (src/, test/, fixtures/,
# package.json …) sind nicht erreichbar — sie werden ebenfalls nach dist/…
# umgeschrieben und laufen dort ins 404.
#
# Nach jedem `git pull` auf dem Server ist der Stand von dist/ der Stand, der
# im Repo liegt. Der Build gehört also mit ins Repo (siehe README).
#
# Diese Datei liegt bewusst „ortsunabhängig“: sie funktioniert im Wurzel-
# verzeichnis genauso wie in einem Unterordner (httpdocs/transformer/), etwa
# neben einem WordPress in der Wurzel. Deshalb steht hier **kein**
# `RewriteBase`. Ein `RewriteBase /` würde die Ziele der Regeln an die Wurzel
# hängen: aus dist/index.html würde /dist/index.html statt
# /transformer/dist/index.html — das gibt es nicht, und die .htaccess der
# Wurzel (WordPress) schickt die Anfrage dann an ihre index.php. Man landet
# also im WordPress statt im Build.

Options -MultiViews -Indexes

# Ein 404 in diesem Ordner soll hier bleiben. Ohne diese Zeile greift ein
# `ErrorDocument 404 /index.php` aus der Wurzel — das erbt bis hier herunter
# und liefert die 404-Seite von WordPress aus.
ErrorDocument 404 default

DirectoryIndex dist/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Versteckte Verzeichnisse und Dateien gar nicht erst anfassen (.git, .github).
  RewriteRule (^|/)\. - [F,L]

  # Schon in dist/ — sonst dreht sich die Regel im Kreis.
  RewriteRule ^dist/ - [L]

  # Startseite
  RewriteRule ^$ dist/index.html [L]

  # Alles andere aus dist/ holen: /assets/index-abc123.js -> dist/assets/…
  # Die Ziele sind relativ; Apache setzt den Pfad dieses Ordners davor. Nur
  # falls der Server das nicht selbst hinbekommt (Alias, exotische vHost-
  # Konfiguration), den Pfad hier fest eintragen:
  #   RewriteBase /transformer/
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

# Das Mikrofon braucht einen sicheren Kontext — ohne HTTPS bleibt der
# Aufnahmeknopf tot. In Plesk gibt es dafür „Dauerhafte SEO-sichere
# 301-Umleitung von HTTP zu HTTPS“; das ist der saubere Weg. Nur falls die
# Umleitung dort nicht greift, diesen Block einschalten:
#
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/json .map
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Vite hängt einen Hash an jeden Dateinamen — die Dateien ändern sich nie,
  # sie werden ersetzt. Also lange cachen.
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresDefault "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Die index.html verweist auf die gehashten Dateien und muss deshalb bei
  # jedem Aufruf neu geholt werden, sonst zeigt der Browser nach einem Deploy
  # weiter auf den alten Build.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
